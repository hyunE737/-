{
  "name": "nuri-life",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-16",
  "build": { "command": "node cloudflare/build.cjs" },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/.netlify/functions/ranking", "/api/ranking", "/thanks", "/nuri-update.json"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "nuri-life" }]
}
